---
import { languages, pages, type Language, type SitePage } from '../config/pages';
import SiteLayout from '../layouts/SiteLayout.astro';
import Home from '../components/Home.astro';
import ContentPage from '../components/ContentPage.astro';
import Contact from '../components/Contact.astro';

export function getStaticPaths() {
  return pages.flatMap((page) => languages.map((language) => ({
    params: { path: page.routes[language] || undefined },
    props: { page, language },
  })));
}

interface Props { page: SitePage; language: Language }
const { page, language } = Astro.props;
const content = page.content[language];
---
<SiteLayout page={page} language={language} title={content.title} description={content.description}>
  {page.template === 'home'
    ? <Home content={page.content[language]} />
    : page.template === 'contact'
      ? <Contact content={page.content[language]} language={language} />
      : <ContentPage content={page.content[language]} />}
</SiteLayout>
