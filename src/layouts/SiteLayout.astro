---
import { languages, type Language, type SitePage } from '../config/pages';
import { canonicalUrl, isIndexable } from '../config/seo';
import { interfaceText } from '../config/interface';
import Header from '../components/Header.astro';
import { contact } from '../config/contact';
import favicon from '../../assets/favicon/favicon.ico?url';
import favicon16 from '../../assets/favicon/favicon-16x16.png?url';
import favicon32 from '../../assets/favicon/favicon-32x32.png?url';
import appleTouchIcon from '../../assets/favicon/apple-touch-icon.png?url';
import mainStyles from '../styles/main.css?url';
import responsiveStyles from '../styles/responsive.css?url';
import fontStyles from '../styles/fonts.css?url';
import sansGreek from '../assets/fonts/noto-sans-greek.woff2?url';
import sansLatin from '../assets/fonts/noto-sans-latin.woff2?url';
import serifGreek from '../assets/fonts/noto-serif-greek.woff2?url';
import serifLatin from '../assets/fonts/noto-serif-latin.woff2?url';

interface Props { page: SitePage; language: Language; title: string; description: string }
const { page, language, title, description } = Astro.props;
const text = interfaceText[language];
const instagramHandle = contact.instagramUrl ? `@${new URL(contact.instagramUrl).pathname.split('/').filter(Boolean)[0]}` : '';
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Load before first paint, including in development where CSS imports use JavaScript. -->
    {[sansGreek, sansLatin, serifGreek, serifLatin].map(font => <link rel="preload" href={font} as="font" type="font/woff2" crossorigin="anonymous" />)}
    <link rel="stylesheet" href={fontStyles} />
    <link rel="stylesheet" href={mainStyles} />
    <link rel="stylesheet" href={responsiveStyles} />
    <script is:inline>document.documentElement.classList.add('has-js');</script>
    <link rel="icon" href={favicon} sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href={favicon16} />
    <link rel="icon" type="image/png" sizes="32x32" href={favicon32} />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/site.webmanifest`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={isIndexable(page) ? 'index, follow' : 'noindex, follow'} />
    <link rel="canonical" href={canonicalUrl(page, language)} />
    {isIndexable(page) && languages.map((alternate) => <link rel="alternate" hreflang={alternate} href={canonicalUrl(page, alternate)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{text.skip}</a>
    <Header page={page} language={language} />
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <span class="footer-brand">{text.brand}</span>
        <p>{text.footer}</p>
        {contact.instagramUrl && <a class="footer-instagram" href={contact.instagramUrl} aria-label={`${text.instagramLabel} · ${instagramHandle}`}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none" />
          </svg>
          <span><small>{instagramHandle}</small></span>
          <span aria-hidden="true">↗</span>
        </a>}
      </div>
    </footer>
  </body>
</html>
