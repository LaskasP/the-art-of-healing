---
import { home } from '../content/home';
interface Props { content: (typeof home)['el'] | (typeof home)['en'] }
const { content } = Astro.props;
---
<section class="hero" aria-labelledby="home-heading">
  <p class="eyebrow">{content.eyebrow}</p>
  <h1 id="home-heading">{content.heading}</h1>
  <p class="introduction">{content.introduction}</p>
</section>
<aside class="notice" aria-labelledby="notice-heading">
  <h2 id="notice-heading">{content.noticeTitle}</h2>
  <p>{content.notice}</p>
</aside>
<section class="service-area" aria-labelledby="area-heading">
  <h2 id="area-heading">{content.areaHeading}</h2>
  <div class="area-grid">
    {content.areas.map((area) => <div class="area"><h3>{area.title}</h3><p>{area.text}</p></div>)}
  </div>
  <div class="online"><h3>{content.onlineTitle}</h3><p>{content.onlineText}</p></div>
</section>
